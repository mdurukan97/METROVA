{
  "name": "metrova",
  "version": "0.2.0",
  "private": true,
  "description": "METROVA - Istanbul atlas transit management game",
  "creator": {
    "version": "3.8.8"
  },
  "devDependencies": {
    "@cocos/creator-types": "3.8.8",
    "typescript": "^5.4.0",
    "tsx": "^4.19.0"
  },
  "scripts": {
    "atlas:fetch": "node tools/fetch-istanbul-atlas.mjs",
    "atlas:validate": "node tools/validate-station-districts.mjs",
    "atlas:m4": "node tools/fetch-m4-stations.mjs",
    "atlas:roads": "node tools/fetch-night-roads.mjs",
    "atlas:night": "npm run atlas:fetch && npm run atlas:m4 && npm run atlas:m4:merge && npm run atlas:roads && npm run atlas:validate",
    "atlas:m4:merge": "node tools/merge-m4-atlas.mjs",
    "test": "tsx --test tests/**/*.test.ts"
  }
}

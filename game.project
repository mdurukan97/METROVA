[project]
title = METROVA
version = 0.1.0

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc

[display]
width = 1980
height = 900
high_dpi = 1
vsync = 1
dynamic_orientation = 0

[script]
shared_state = 1

[android]
package = com.mhdrn.metrova
input_method = HiddenInputField
immersive_mode = 1

[physics]
gravity_y = 0.0
scale = 0.01

[html5]
scale_mode = stretch
